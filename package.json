{
  "name": "harulog",
  "version": "1.9.5",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.6",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-pager-view": "8.0.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "desktop": "concurrently -k -n web,electron \"npm run web\" \"electron ./electron/main.js\"",
    "desktop:build": "expo export -p web && electron-builder --mac",
    "export:web": "expo export -p web && node scripts/inject-pwa-head.js"
  },
  "build": {
    "appId": "com.otaetree.harulog",
    "productName": "하루로그",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png"
    }
  },
  "private": true
}
